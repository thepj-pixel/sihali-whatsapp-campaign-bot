{
  "name": "sihali-whatsapp-campaign-bot",
  "version": "1.0.0",
  "description": "Multi-session WhatsApp Voter Engine for Gram Panchayat Sihali Khurd 2026",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node test.js",
    "test:production": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node test_production_workflows.cjs",
    "test:conversation": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_simulate_50_casual_messages.cjs')\"",
    "test:ladder": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_5step_ladder.cjs')\"",
    "test:readiness": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_mass_campaign_readiness.cjs')\"",
    "test:burst": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_brutal_300_full_pipeline.cjs')\"",
    "test:all": "npm run test:production && npm run test:broadcast && npm run test:brain && npm run test:queue && npm run test:tabs && npm run test:conversation && npm run test:ladder && npm run test:readiness && npm run test:burst && npm run test:brainv2 && npm run test:brainv3 && npm run test:ops && npm run test:identity && npm run test:crm && npm run test:script && npm run test:ui",
    "test:broadcast": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node test_broadcast_engine.cjs",
    "test:brain": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_reply_brain.cjs')\"",
    "test:queue": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node test_chat_queue.cjs",
    "test:tabs": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node test_dashboard_tabs.cjs",
    "test:brainv2": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_brain_v2_conversations.cjs')\"",
    "test:brainv3": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_brain_v3_conversations.cjs')\"",
    "test:ops": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node test_ops_v4.cjs",
    "test:ui": "python3 test_dashboard_ui.py",
    "test:identity": "DEFAULT_SCRIPT=auto SCRIPT_ASK=off node test_identity_sync.cjs",
    "test:crm": "node test_crm_emoji_media.cjs",
    "test:script": "node test_script_pref.cjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4"
  }
}
