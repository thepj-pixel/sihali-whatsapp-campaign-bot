{
  "name": "sihali-whatsapp-campaign-bot",
  "version": "1.0.0",
  "description": "Multi-session WhatsApp Voter Engine for Gram Panchayat Sihali Khurd 2026",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node test.js",
    "test:production": "node test_production_workflows.cjs",
    "test:conversation": "node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_simulate_50_casual_messages.cjs')\"",
    "test:ladder": "node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_5step_ladder.cjs')\"",
    "test:readiness": "node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_mass_campaign_readiness.cjs')\"",
    "test:burst": "node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_brutal_300_full_pipeline.cjs')\"",
    "test:all": "npm run test:production && npm run test:broadcast && npm run test:brain && npm run test:queue && npm run test:tabs && npm run test:conversation && npm run test:ladder && npm run test:readiness && npm run test:burst && npm run test:brainv2 && npm run test:brainv3",
    "test:broadcast": "node test_broadcast_engine.cjs",
    "test:brain": "node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_reply_brain.cjs')\"",
    "test:queue": "node test_chat_queue.cjs",
    "test:tabs": "node test_dashboard_tabs.cjs",
    "test:brainv2": "node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_brain_v2_conversations.cjs')\"",
    "test:brainv3": "node -e \"const m=require('./user_memory.js');m.save=()=>{};require('./test_brain_v3_conversations.cjs')\""
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4"
  }
}
