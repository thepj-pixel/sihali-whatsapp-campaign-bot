PORT=3000
CAMPAIGN_PIN=change-me
DEPLOY_BRANCH=codex/production-readiness
PUBLIC_DASHBOARD_URL=https://dashboard.example.com

# NVIDIA keys are tried in order: NVIDIA_API_KEY, NVIDIA_API_KEYS (comma separated), then api_config.json nvidia_keys
NVIDIA_API_KEY=
NVIDIA_API_KEYS=
GROQ_API_KEY=
GEMINI_API_KEY=

MEDIA_GIT_SYNC=true
PROFILE_GIT_SYNC=true
DASHBOARD_ONLY=false

# Optional test/alternate data paths
CAMPAIGN_PROFILE_PATH=
CONTACTS_DB_PATH=
VOTERS_PATH=


# Incoming message queue (volume)
INCOMING_CONCURRENCY=12
INCOMING_JOB_TIMEOUT_MS=45000
# Reply brain (set off to fall back to the old LLM-first path)
REPLY_BRAIN=on
# Also add new contacts to each WhatsApp line's own address book (Baileys addOrEditContact)
WA_SYNC_CONTACTS=true
# Optional alternate runtime paths
BROADCAST_STATE_PATH=
CAMPAIGN_AGENDA_PATH=
